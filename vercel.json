{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "texflow-site.vercel.app"
        }
      ],
      "destination": "https://www.texflow.com.br/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/oauth",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/oauth/callback",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
