---
import Logo from "./Logo.astro";

const quickLinks = ["Home", "Sobre Nós", "Soluções", "Aplicações", "Diferenciais", "Processo", "Cases", "Contato"];
const solutionLinks = [
  "Revestimento antiaderente industrial",
  "Revestimento antiaderente alimentício",
  "Texturização industrial",
  "A CONFIRMAR",
];
const socials = [
  { label: "Instagram", href: "https://www.instagram.com/texflow.pr", icon: "M7 2h10a5 5 0 015 5v10a5 5 0 01-5 5H7a5 5 0 01-5-5V7a5 5 0 015-5zm5 5.5a4.5 4.5 0 100 9 4.5 4.5 0 000-9zm5.2-1.8a1 1 0 100 2 1 1 0 000-2z" },
  { label: "Facebook", href: "https://www.facebook.com/Texfllow", icon: "M14 9h3V6h-3c-1.7 0-3 1.3-3 3v2H9v3h2v7h3v-7h3l1-3h-4V9c0-.3.2-1 1-1z" },
  { label: "LinkedIn", href: "https://www.linkedin.com/company/tewflow-texturiza%C3%A7%C3%A3o-e-revestimentos", icon: "M4.5 3A1.5 1.5 0 003 4.5v15A1.5 1.5 0 004.5 21h15a1.5 1.5 0 001.5-1.5v-15A1.5 1.5 0 0019.5 3h-15zM8.3 18H5.7V9.7h2.6V18zM7 8.5a1.5 1.5 0 110-3 1.5 1.5 0 010 3zM18.3 18h-2.6v-4.3c0-1-.4-1.7-1.3-1.7-.7 0-1.1.5-1.3 1-.1.2-.1.5-.1.8V18h-2.6s.1-7.4 0-8.2h2.6v1.2c.3-.5 1-1.3 2.4-1.3 1.7 0 3 1.1 3 3.6V18z" },
  { label: "YouTube", href: "https://www.youtube.com/@texflowtexturizacaoerevest4103", icon: "M22 12s0-3.2-.4-4.7c-.2-.9-.9-1.5-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.5c-.9.2-1.6.9-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.7c.2.9.9 1.6 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.5c.9-.2 1.6-.9 1.8-1.8.4-1.5.4-4.7.4-4.7zM10 15V9l5.2 3-5.2 3z" },
];
---

<footer class="bg-navy-950 text-white">
  <div class="max-w-7xl mx-auto px-6 lg:px-10 py-14 grid sm:grid-cols-2 lg:grid-cols-5 gap-10">
    <div class="lg:col-span-1 sm:col-span-2">
      <Logo variant="light" showTagline={false} large />
      <p class="mt-4 text-sm text-white/60 leading-relaxed max-w-xs">
        Revestimentos antiaderentes e texturizações industriais. Tecnologia,
        qualidade e performance para transformar processos e gerar
        resultados.
      </p>
    </div>

    <div>
      <h4 class="font-bold text-sm tracking-wide mb-4">LINKS RÁPIDOS</h4>
      <ul class="space-y-2.5 text-sm text-white/60">
        {quickLinks.map((l) => <li><a href="#" class="hover:text-orange-400 transition-colors">{l}</a></li>)}
      </ul>
    </div>

    <div>
      <h4 class="font-bold text-sm tracking-wide mb-4">SOLUÇÕES</h4>
      <ul class="space-y-2.5 text-sm text-white/60">
        {solutionLinks.map((l) => <li><a href="#solucoes" class="hover:text-orange-400 transition-colors">{l}</a></li>)}
      </ul>
    </div>

    <div>
      <h4 class="font-bold text-sm tracking-wide mb-4">CONTATO</h4>
      <ul class="space-y-3 text-sm text-white/60">
        <li class="flex items-center gap-2">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" class="shrink-0"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.9 21 3 13.1 3 3c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8z"/></svg>
          (41) 3403-0144
        </li>
        <li class="flex items-center gap-2">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" class="shrink-0"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.9 21 3 13.1 3 3c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8z"/></svg>
          (41) 98904-6545
        </li>
        <li class="flex items-center gap-2">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="shrink-0"><path d="M3 6h18v12H3V6zm0 0l9 7 9-7"/></svg>
          texflow.pr@gmail.com
        </li>
        <li class="flex items-start gap-2">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="shrink-0 mt-0.5"><path d="M12 21s-7-5.2-9.5-9.4C.7 8.4 2 4.5 5.6 3.4 8 2.7 10.3 3.7 12 6c1.7-2.3 4-3.3 6.4-2.6 3.6 1.1 4.9 5 3.1 8.2C19 15.8 12 21 12 21z"/></svg>
          <span>Rua Uniflor, 1012 - Emiliano Perneta<br />Pinhais - PR</span>
        </li>
      </ul>
    </div>

    <div>
      <h4 class="font-bold text-sm tracking-wide mb-4">REDES SOCIAIS</h4>
      <div class="flex gap-3">
        {
          socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} class="w-9 h-9 rounded-md bg-white/10 flex items-center justify-center hover:bg-orange-500 transition-colors">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d={s.icon} /></svg>
            </a>
          ))
        }
      </div>

      <div class="mt-6 inline-block border border-white/15 rounded-md px-3 py-2 text-xs text-white/60">
        CNPJ: 01.160.002/0001-00
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 py-5 text-center text-xs text-white/50">
      © 2026 TexFlow. Todos os direitos reservados.
    </div>
  </div>
</footer>
