---

<section class="relative overflow-hidden min-h-[560px] lg:min-h-[680px] flex items-center">
  <div class="absolute inset-0 bg-gradient-to-br from-[#232a31] via-[#14181d] to-[#0a0d10]"></div>

  <div class="roller-wrap absolute inset-y-0 right-0 w-[42%] sm:w-[70%] lg:w-[68%]">
    <div class="roller-body"></div>
    <div class="roller-hub"></div>
    <div class="roller-shaft"></div>
  </div>

  <div class="absolute inset-0 bg-gradient-to-r from-navy-950 via-navy-950 to-navy-950/40 sm:via-navy-950/85 sm:to-navy-950/10"></div>

  <div class="relative w-full max-w-7xl mx-auto px-6 lg:px-10">
    <div class="max-w-xl py-20 lg:py-28">
      <h1 class="text-3xl sm:text-4xl lg:text-[2.75rem] font-extrabold leading-tight text-white">
        REVESTIMENTOS QUE PROTEGEM.<br />
        TECNOLOGIA QUE<br />
        <span class="text-orange-500">ELEVA RESULTADOS.</span>
      </h1>
      <p class="mt-5 text-white/75 text-base leading-relaxed max-w-lg">
        Soluções em revestimentos antiaderentes e texturizações industriais que
        aumentam a eficiência, reduzem custos e prolongam a vida útil dos seus
        equipamentos e processos.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="#contato"
          class="flex items-center gap-2 bg-orange-500 text-white font-semibold px-6 py-3.5 rounded-md hover:bg-orange-600 transition-colors"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none">
            <path d="M8 3h8a2 2 0 012 2v14l-6-3-6 3V5a2 2 0 012-2z" stroke="white" stroke-width="1.8" stroke-linejoin="round" />
          </svg>
          Solicitar Orçamento
        </a>
        <a
          href="https://wa.me/554134034034"
          target="_blank"
          rel="noopener"
          class="flex items-center gap-2 border border-white/60 text-white font-semibold px-6 py-3.5 rounded-md hover:bg-white hover:text-navy-900 transition-colors"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2a10 10 0 00-8.6 15L2 22l5.2-1.4A10 10 0 1012 2zm0 18.2a8.2 8.2 0 01-4.2-1.2l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1112 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1-.2.2-.7.8-.8.9-.1.2-.3.2-.6.1-.2-.1-1-.4-1.9-1.2-.7-.6-1.2-1.4-1.3-1.6-.1-.2 0-.4.1-.5.1-.1.2-.3.4-.4.1-.1.2-.2.2-.4.1-.2 0-.3 0-.4-.1-.1-.6-1.4-.8-1.9-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 1.9s.8 2.2 1 2.4c.1.2 1.6 2.5 4 3.5.6.2 1 .4 1.3.5.6.2 1.1.1 1.5.1.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2-.1-.1-.2-.2-.4-.3z" />
          </svg>
          Falar no WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .roller-body {
    position: absolute;
    left: -8%;
    top: 50%;
    transform: translateY(-50%);
    width: 62%;
    height: 78%;
    border-radius: 0 60px 60px 0;
    background:
      radial-gradient(circle at 8px 8px, rgba(255, 255, 255, 0.14) 1.6px, transparent 1.8px) 0 0/14px 14px,
      radial-gradient(circle at 60% 35%, #3a4149 0%, #1c2126 55%, #0a0c0e 100%);
    box-shadow: inset -10px 0 30px rgba(0, 0, 0, 0.6);
  }
  .roller-hub {
    position: absolute;
    left: 52%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 20%;
    aspect-ratio: 1 / 1;
    border-radius: 9999px;
    background: radial-gradient(circle at 35% 30%, #cfd6dc 0%, #8a939b 40%, #4b5259 75%, #2a2e33 100%);
    box-shadow: 0 0 0 6px rgba(0, 0, 0, 0.25), inset 0 0 12px rgba(0, 0, 0, 0.4);
  }
  .roller-hub::after {
    content: "";
    position: absolute;
    inset: 32%;
    border-radius: 9999px;
    background: radial-gradient(circle at 40% 35%, #4b5259 0%, #23272b 70%);
    box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.6);
  }
  .roller-shaft {
    position: absolute;
    right: -6%;
    top: 50%;
    transform: translateY(-50%);
    width: 38%;
    height: 30%;
    border-radius: 0 16px 16px 0;
    background: linear-gradient(180deg, #cfd6dc 0%, #9aa2a9 30%, #545a60 70%, #33373b 100%);
  }
</style>
