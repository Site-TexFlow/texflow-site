---
interface Props {
  segments?: string[];
  formSource?: string;
}

const {
  segments = [
    "Alimentícia",
    "Automobilística",
    "Têxtil",
    "Plástica",
    "Borracha",
    "Gráfica",
    "Agrícola",
    "Outro",
  ],
  formSource = "contato",
} = Astro.props;
---

<section id="contato" class="bg-navy-900">
  <div class="max-w-7xl mx-auto px-6 lg:px-10 py-16 lg:py-20 grid lg:grid-cols-2 gap-12 items-start">
    <div class="text-white">
      <h2 class="text-2xl sm:text-3xl font-extrabold leading-tight">
        PRONTO PARA ELEVAR A <span class="text-orange-500">PERFORMANCE</span> DOS SEUS EQUIPAMENTOS?
      </h2>
      <p class="mt-5 text-white leading-relaxed max-w-md">
        Fale com nossos especialistas e solicite seu orçamento sem
        compromisso.
      </p>

      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="#contato"
          class="flex items-center gap-2 bg-orange-500 text-white font-semibold px-6 py-3.5 rounded-md hover:bg-orange-600 transition-colors"
        >
          Solicitar Orçamento
        </a>
        <a
          href="https://wa.me/5541989046545"
          target="_blank"
          rel="noopener"
          class="flex items-center gap-2 border border-white/40 text-white font-semibold px-6 py-3.5 rounded-md hover:bg-white/10 transition-colors"
        >
          Falar no WhatsApp
        </a>
      </div>

      <div class="mt-10 flex items-center gap-4 bg-white/5 border border-white/10 rounded-xl p-4 max-w-md">
        <div class="w-12 h-12 rounded-full overflow-hidden shrink-0 relative bg-[#009c3b]">
          <div class="absolute inset-[18%] bg-[#ffdf00]" style="clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%)"></div>
          <div class="absolute inset-[34%] rounded-full bg-[#002776]"></div>
        </div>
        <div>
          <div class="font-extrabold text-sm tracking-wide">BRAZILIAN TECHNOLOGY</div>
          <div class="text-white/60 text-xs mt-1 leading-snug">
            Tecnologia brasileira. Qualidade, inovação e confiança em cada
            aplicação.
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-xl">
      <h3 class="text-xl font-extrabold text-navy-900">
        SOLICITE UM <span class="text-orange-500">ORÇAMENTO</span>
      </h3>
      <p class="mt-2 text-sm text-muted">
        Preencha o formulário e nossa equipe entrará em contato.
      </p>

      <form id="cta-form" data-form-source={formSource} class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
        <input
          id="cta-name"
          type="text"
          placeholder="Nome completo*"
          required
          class="w-full rounded-md border border-slate-200 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400"
        />
        <input
          id="cta-company"
          type="text"
          placeholder="Empresa*"
          required
          class="w-full rounded-md border border-slate-200 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400"
        />
        <input
          id="cta-email"
          type="email"
          placeholder="E-mail*"
          required
          class="w-full rounded-md border border-slate-200 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400"
        />
        <input
          id="cta-whatsapp"
          type="tel"
          inputmode="tel"
          placeholder="WhatsApp*"
          required
          class="w-full rounded-md border border-slate-200 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400"
        />
        <select
          id="cta-segment"
          required
          class="w-full self-start rounded-md border border-slate-200 px-4 py-3 text-sm text-muted focus:outline-none focus:ring-2 focus:ring-orange-400"
        >
          <option value="" selected disabled>Segmento de atuação*</option>
          {segments.map((s) => <option value={s}>{s}</option>)}
        </select>
        <textarea
          id="cta-message"
          placeholder="Descreva sua necessidade*"
          required
          maxlength="500"
          rows="4"
          class="w-full rounded-md border border-slate-200 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 resize-none"
        ></textarea>

        <label class="col-span-full flex items-start gap-2.5 text-xs text-muted">
          <input type="checkbox" required class="mt-0.5 accent-orange-500" />
          Concordo com o uso dos meus dados para contato comercial, conforme a
          <a href="/politica-de-privacidade" class="text-orange-500 underline">Política de Privacidade</a>.*
        </label>

        <button
          id="cta-submit"
          type="submit"
          class="col-span-full flex items-center justify-center gap-2 bg-orange-500 text-white font-semibold px-6 py-3.5 rounded-md hover:bg-orange-600 transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
        >
          <span id="cta-submit-label">Solicitar Orçamento</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
            <path d="M4 12h16m0 0l-6-6m6 6l-6 6" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        <p id="cta-status" class="col-span-full text-sm hidden" role="status"></p>
      </form>
    </div>
  </div>
</section>

<script>
  // Telefone: aceita fixo/celular brasileiro ou número estrangeiro com
  // código de país (+55...). O padrão fica oculto — só aparece como erro
  // se o número digitado não bater com nenhum dos formatos.
  function isValidPhone(raw: string) {
    const trimmed = raw.trim();
    const digits = trimmed.replace(/\D/g, "");

    if (trimmed.startsWith("+") && !trimmed.startsWith("+55")) {
      // Estrangeiro: entre 8 e 15 dígitos (padrão E.164), com "+" e código do país.
      return digits.length >= 8 && digits.length <= 15;
    }

    // Brasileiro: remove o código de país 55 se foi digitado.
    let local = digits;
    if (local.length > 11 && local.startsWith("55")) {
      local = local.slice(2);
    }

    if (local.length === 10) {
      // Fixo: DDD (2 díg.) + número (8 díg., não pode começar com 9 — isso é celular).
      return /^[1-9]{2}[2-8]\d{7}$/.test(local);
    }
    if (local.length === 11) {
      // Celular: DDD (2 díg.) + 9 + número (8 díg.).
      return /^[1-9]{2}9\d{8}$/.test(local);
    }
    return false;
  }

  function isValidEmail(raw: string) {
    return /^[^\s@]+@[^\s@]+\.[a-zA-Z]{2,}$/.test(raw.trim());
  }

  const whatsappInput = document.getElementById("cta-whatsapp") as HTMLInputElement | null;
  whatsappInput?.addEventListener("input", () => {
    whatsappInput.setCustomValidity(
      whatsappInput.value === "" || isValidPhone(whatsappInput.value)
        ? ""
        : "Digite um número de WhatsApp válido: fixo ou celular brasileiro (com DDD) ou número estrangeiro com código do país (+)."
    );
  });

  const emailInput = document.getElementById("cta-email") as HTMLInputElement | null;
  emailInput?.addEventListener("input", () => {
    emailInput.setCustomValidity(
      emailInput.value === "" || isValidEmail(emailInput.value) ? "" : "Digite um e-mail válido."
    );
  });

  const form = document.getElementById("cta-form") as HTMLFormElement | null;
  const submitButton = document.getElementById("cta-submit") as HTMLButtonElement | null;
  const submitLabel = document.getElementById("cta-submit-label");
  const status = document.getElementById("cta-status");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;

    const name = (document.getElementById("cta-name") as HTMLInputElement).value.trim();
    const company = (document.getElementById("cta-company") as HTMLInputElement).value.trim();
    const email = (document.getElementById("cta-email") as HTMLInputElement).value.trim();
    const whatsapp = (document.getElementById("cta-whatsapp") as HTMLInputElement).value.trim();
    const segment = (document.getElementById("cta-segment") as HTMLSelectElement).value;
    const message = (document.getElementById("cta-message") as HTMLTextAreaElement).value.trim();
    const source = form.dataset.formSource || "contato";

    if (submitButton) submitButton.disabled = true;
    if (submitLabel) submitLabel.textContent = "Enviando...";
    if (status) {
      status.classList.add("hidden");
      status.classList.remove("text-red-600", "text-green-600");
    }

    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name, company, email, whatsapp, segment, message, source }),
      });

      if (!res.ok) {
        const data = await res.json().catch(() => ({}));
        throw new Error(data.error || "Falha ao enviar. Tente novamente.");
      }

      form.reset();
      window.dataLayer = window.dataLayer || [];
      dataLayer.push({event: 'form_submit'});
      if (status) {
        status.textContent = "Mensagem enviada! Nossa equipe vai entrar em contato em breve.";
        status.classList.remove("hidden");
        status.classList.add("text-green-600");
      }
    } catch (err) {
      if (status) {
        status.textContent = err instanceof Error ? err.message : "Falha ao enviar. Tente novamente.";
        status.classList.remove("hidden");
        status.classList.add("text-red-600");
      }
    } finally {
      if (submitButton) submitButton.disabled = false;
      if (submitLabel) submitLabel.textContent = "Solicitar Orçamento";
    }
  });
</script>
