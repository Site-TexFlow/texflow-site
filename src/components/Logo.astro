---
interface Props {
  variant?: "light" | "dark";
  showTagline?: boolean;
  large?: boolean;
}
const { variant = "dark", showTagline = true, large = false } = Astro.props;
const textColor = variant === "dark" ? "text-navy-900" : "text-white";
const taglineColor = variant === "dark" ? "text-muted" : "text-white/60";
const iconBg = variant === "dark" ? "#0A1C34" : "white";
const iconMark = variant === "dark" ? "white" : "#0A1C34";
const iconSize = large ? 44 : 34;
const textSize = large ? "text-2xl sm:text-3xl" : "text-xl";
const clipId = `logo-clip-${Math.random().toString(36).slice(2, 9)}`;
---

<a href="/" class="flex items-center gap-3 shrink-0">
  <svg width={iconSize} height={iconSize} viewBox="0 0 34 34" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <clipPath id={clipId}>
        <circle cx="17" cy="17" r="17" />
      </clipPath>
    </defs>
    <g clip-path={`url(#${clipId})`}>
      <circle cx="17" cy="17" r="17" fill={iconBg} />
      <rect x="-3" y="7.8" width="40" height="4.3" fill={iconMark} />
      <rect x="14.58" y="7.8" width="4.85" height="32" fill={iconMark} />
    </g>
  </svg>
  <div class="leading-none">
    <div class={`font-extrabold tracking-tight ${textSize} ${textColor}`}>
      TEXFLOW
    </div>
    {
      showTagline && (
        <div class={`text-[9px] font-semibold tracking-wide uppercase ${taglineColor} leading-tight mt-0.5`}>
          Revestimentos antiaderentes<br />e texturizações industriais
        </div>
      )
    }
  </div>
</a>
