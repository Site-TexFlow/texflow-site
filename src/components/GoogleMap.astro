---
const lat = -25.4206268;
const lng = -49.49086520546873;
const googleMapsUrl = `https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}`;
const wazeUrl = `https://waze.com/ul?ll=${lat}%2C${lng}&navigate=yes`;

const dLat = 0.006;
const dLng = 0.012;
const bbox = [lng - dLng, lat - dLat, lng + dLng, lat + dLat].join(",");
const osmEmbedUrl = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&marker=${lat},${lng}`;
---

<div class="relative rounded-xl overflow-hidden shadow-sm border border-slate-100 bg-white aspect-[16/9] sm:aspect-[21/9]">
  <iframe
    src={osmEmbedUrl}
    width="100%"
    height="100%"
    style="border:0;"
    loading="lazy"
    title="Mapa da localização da TexFlow em Pinhais, PR"
    class="w-full h-full"
  ></iframe>

  <button
    id="map-directions-trigger"
    type="button"
    aria-haspopup="true"
    class="absolute bottom-4 right-4 flex items-center gap-1.5 bg-white shadow-md rounded-md px-3.5 py-2 text-xs font-semibold text-navy-900 cursor-pointer hover:bg-slate-50 transition-colors"
  >
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-orange-500">
      <path d="M3 11l18-8-8 18-2-8-8-2z" />
    </svg>
    Como chegar
  </button>

  <div
    id="map-directions-popover"
    class="hidden absolute inset-0 bg-navy-900/70 backdrop-blur-sm items-center justify-center p-6"
  >
    <div class="bg-white rounded-xl shadow-xl p-5 sm:p-6 max-w-xs w-full">
      <div class="flex items-center justify-between mb-4">
        <span class="font-extrabold text-sm text-navy-900 tracking-wide">TRAÇAR ROTA</span>
        <button id="map-directions-close" type="button" aria-label="Fechar" class="text-muted hover:text-navy-900 transition-colors">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </div>
      <div class="flex flex-col gap-3">
        <a
          href={googleMapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 bg-orange-500 text-white font-semibold px-5 py-3 rounded-md hover:bg-orange-600 transition-colors text-sm"
        >
          Abrir no Google Maps
        </a>
        <a
          href={wazeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 border border-slate-200 text-navy-900 font-semibold px-5 py-3 rounded-md hover:bg-slate-50 transition-colors text-sm"
        >
          Abrir no Waze
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  const trigger = document.getElementById("map-directions-trigger");
  const popover = document.getElementById("map-directions-popover");
  const closeBtn = document.getElementById("map-directions-close");

  const open = () => popover?.classList.replace("hidden", "flex");
  const close = () => popover?.classList.replace("flex", "hidden");

  trigger?.addEventListener("click", open);
  closeBtn?.addEventListener("click", close);
  popover?.addEventListener("click", (e) => {
    if (e.target === popover) close();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") close();
  });
</script>
