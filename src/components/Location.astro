---
import GoogleMap from "./GoogleMap.astro";
---

<section id="onde-estamos" class="bg-white">
  <div class="max-w-7xl mx-auto px-6 lg:px-10 py-16 lg:py-20">
    <div class="text-center max-w-2xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-900">
        ONDE <span class="text-orange-500">ESTAMOS</span>
      </h2>
      <p class="mt-3 text-muted leading-relaxed">
        Visite nossa empresa ou fale com nosso time.
      </p>
    </div>

    <div class="mt-10 max-w-5xl mx-auto">
      <GoogleMap />
    </div>
  </div>
</section>
