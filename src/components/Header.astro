---
import Logo from "./Logo.astro";

const navLinks = [
  { label: "Home", href: "/" },
  { label: "Sobre Nós", href: "/sobre-nos" },
  { label: "Soluções", href: "/solucoes", dropdown: true },
  { label: "Aplicações", href: "/aplicacoes" },
  { label: "Diferenciais", href: "/diferenciais" },
  { label: "Processo", href: "/processo" },
  { label: "Cases", href: "/cases" },
  { label: "Blog", href: "/blog" },
  { label: "Contato", href: "/contato" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === "/") return currentPath === "/";
  if (href.startsWith("/")) return currentPath === href || currentPath.startsWith(`${href}/`);
  return false;
};
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-slate-100">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 h-24 flex items-center justify-between gap-4">
    <Logo variant="dark" showTagline={false} large />

    <nav class="hidden lg:flex items-center gap-5 xl:gap-7 text-[13px] xl:text-sm font-semibold text-navy-900 whitespace-nowrap">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class={`relative flex items-center gap-1 py-2 hover:text-orange-500 transition-colors ${
              isActive(link.href) ? "text-orange-500" : ""
            }`}
          >
            {link.label.toUpperCase()}
            {link.dropdown && (
              <svg width="10" height="6" viewBox="0 0 10 6" fill="none" class="mt-0.5">
                <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              </svg>
            )}
            {isActive(link.href) && (
              <span class="absolute -bottom-1 left-0 right-0 h-0.5 bg-orange-500 rounded-full" />
            )}
          </a>
        ))
      }
    </nav>

    <button
      id="mobile-menu-btn"
      class="lg:hidden flex flex-col gap-1.5 p-2"
      aria-label="Abrir menu"
    >
      <span class="w-6 h-0.5 bg-navy-900"></span>
      <span class="w-6 h-0.5 bg-navy-900"></span>
      <span class="w-6 h-0.5 bg-navy-900"></span>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden lg:hidden border-t border-slate-100 bg-white px-6 py-4">
    <div class="flex flex-col gap-3 text-sm font-semibold text-navy-900">
      {
        navLinks.map((link) => (
          <a href={link.href} class={isActive(link.href) ? "text-orange-500" : ""}>
            {link.label.toUpperCase()}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
  });
</script>
