---
import { getCollection } from "astro:content";
import "glightbox/dist/css/glightbox.min.css";

// Só itens marcados como destaque aparecem aqui — fotos novas cadastradas
// pelo painel sem essa marcação ficam de fora da galeria da home.
const items = await getCollection("gallery", ({ data }) => data.featured);

const categories = [
  "Alimentícia",
  "Selagem",
  "Rotomoldagem e EPS",
  "Injeção e Extrusão",
  "Gráfica",
  "Texturização",
];
---

{
  items.length > 0 && (
    <section id="galeria" class="bg-slate-50">
      <div class="max-w-7xl mx-auto px-6 lg:px-10 py-16 lg:py-20">
        <h2 class="text-center text-2xl sm:text-3xl font-extrabold text-navy-900">
          GALERIA DE <span class="text-orange-500">PROJETOS</span>
        </h2>
        <p class="mt-3 text-center text-muted max-w-xl mx-auto leading-relaxed">
          Fotos reais de peças, revestimentos e texturizações já entregues pela TexFlow.
        </p>

        <div class="mt-8 flex flex-wrap justify-center gap-2">
          <button
            type="button"
            data-gallery-filter="all"
            class="gallery-filter-btn is-active px-4 py-2 rounded-md text-xs font-bold uppercase tracking-wide border border-orange-500 bg-orange-500 text-white transition-colors"
          >
            Todos
          </button>
          {categories.map((cat) => (
            <button
              type="button"
              data-gallery-filter={cat}
              class="gallery-filter-btn px-4 py-2 rounded-md text-xs font-bold uppercase tracking-wide border border-slate-200 bg-white text-navy-900 hover:border-orange-300 transition-colors"
            >
              {cat}
            </button>
          ))}
        </div>

        <div id="gallery-grid" class="is-preview mt-10 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
          {items.map((item) => (
            <a
              href={item.data.image}
              class="glightbox group relative block aspect-square rounded-xl overflow-hidden shadow-sm border border-slate-100"
              data-gallery="texflow-gallery"
              data-title={item.data.title}
              data-description={item.data.description}
              data-category={item.data.category}
              data-home-card={item.data.homeCard ? "true" : "false"}
            >
              <img
                src={item.data.image}
                alt={item.data.title ?? item.data.category}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="gallery-card-label absolute inset-0 bg-navy-900/50 flex items-center justify-center p-4 text-center">
                <div class="text-white font-bold text-sm uppercase tracking-wide leading-snug">{item.data.category}</div>
              </div>
            </a>
          ))}
        </div>

        <p id="gallery-empty" class="hidden mt-10 text-center text-muted">
          Em breve novas fotos desta categoria.
        </p>
      </div>
    </section>
  )
}

<style>
  .gallery-filter-btn.is-active {
    border-color: var(--color-orange-500);
    background-color: var(--color-orange-500);
    color: white;
  }
  [data-category].is-hidden {
    display: none;
  }
  #gallery-grid.is-preview a:not([data-home-card="true"]) {
    display: none;
  }
  .gallery-card-label {
    opacity: 0;
    transition: opacity 300ms;
  }
  @media (hover: hover) {
    .glightbox:hover .gallery-card-label {
      opacity: 1;
    }
  }
  @media (hover: none) {
    .gallery-card-label {
      opacity: 1;
    }
  }
</style>

<script>
  import GLightbox from "glightbox";

  const lightbox = GLightbox({
    selector: ".glightbox",
    touchNavigation: true,
    loop: true,
    zoomable: true,
  });

  const filterButtons = document.querySelectorAll<HTMLButtonElement>("[data-gallery-filter]");
  const cards = document.querySelectorAll<HTMLElement>("#galeria [data-category]");
  const grid = document.getElementById("gallery-grid");
  const emptyState = document.getElementById("gallery-empty");

  filterButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.dataset.galleryFilter;

      grid?.classList.remove("is-preview");

      filterButtons.forEach((b) => b.classList.remove("is-active"));
      btn.classList.add("is-active");

      let visibleCount = 0;
      cards.forEach((card) => {
        const show = filter === "all" || card.dataset.category === filter;
        card.classList.toggle("is-hidden", !show);
        if (show) visibleCount++;
      });

      emptyState?.classList.toggle("hidden", visibleCount > 0);
    });
  });
</script>
