---
interface Props {
  subtitle?: string;
}
const { subtitle = "Fale com nossos especialistas e solicite seu orçamento sem compromisso." } = Astro.props;
---

<section class="bg-navy-900">
  <div class="max-w-7xl mx-auto px-6 lg:px-10 py-16 lg:py-20 text-center">
    <h2 class="text-2xl sm:text-3xl font-extrabold leading-tight text-white max-w-2xl mx-auto">
      <slot>
        PRONTO PARA ELEVAR A <span class="text-orange-500">PERFORMANCE</span> DOS SEUS EQUIPAMENTOS?
      </slot>
    </h2>
    <p class="mt-5 text-white leading-relaxed max-w-md mx-auto">
      {subtitle}
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a
        href="/contato#contato"
        class="flex items-center gap-2 bg-orange-500 text-white font-semibold px-6 py-3.5 rounded-md hover:bg-orange-600 transition-colors"
      >
        Solicitar Orçamento
      </a>
      <a
        href="https://wa.me/5541989046545"
        target="_blank"
        rel="noopener"
        class="flex items-center gap-2 border border-white/40 text-white font-semibold px-6 py-3.5 rounded-md hover:bg-white/10 transition-colors"
      >
        Falar no WhatsApp
      </a>
    </div>
  </div>
</section>
