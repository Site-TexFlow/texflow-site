---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const dateFormatter = new Intl.DateTimeFormat("pt-BR", { day: "2-digit", month: "long", year: "numeric" });
---

<Layout
  title="Blog TexFlow | Revestimentos e Texturização Industrial"
  description="Conteúdo técnico sobre revestimentos antiaderentes, texturização industrial e engenharia de superfície para equipamentos e peças industriais."
>
  <Header />
  <main>
    <section class="relative overflow-hidden bg-navy-900">
      <div class="absolute inset-0 opacity-[0.06]" style="background-image: radial-gradient(circle at 10px 10px, #ffffff 1.6px, transparent 1.8px); background-size: 16px 16px;"></div>
      <div class="relative max-w-7xl mx-auto px-6 lg:px-10 py-16 lg:py-20 text-center">
        <span class="inline-block text-orange-500 font-bold tracking-wide text-sm uppercase mb-3">Conteúdo técnico</span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-white">
          BLOG <span class="text-orange-500">TEXFLOW</span>
        </h1>
        <p class="mt-4 text-white/70 max-w-2xl mx-auto leading-relaxed">
          Artigos técnicos sobre revestimentos antiaderentes, texturização industrial
          e engenharia de superfície, publicados semanalmente pela nossa equipe.
        </p>
      </div>
    </section>

    <section class="bg-slate-50">
      <div class="max-w-7xl mx-auto px-6 lg:px-10 py-16 lg:py-20">
        {
          posts.length === 0 ? (
            <p class="text-center text-muted">Nenhum post publicado ainda.</p>
          ) : (
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
              {posts.map((post) => (
                <a
                  href={`/blog/${post.id}`}
                  class="group bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden flex flex-col hover:shadow-lg hover:-translate-y-1 transition-all duration-300"
                >
                  <div class="aspect-[16/10] overflow-hidden bg-navy-900">
                    <img
                      src={post.data.image}
                      alt={post.data.imageAlt}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                    />
                  </div>
                  <div class="p-6 flex flex-col flex-1">
                    <div class="flex items-center gap-2 flex-wrap mb-3">
                      {post.data.tags.slice(0, 2).map((tag) => (
                        <span class="text-[10px] font-bold uppercase tracking-wide text-orange-600 bg-orange-100 px-2 py-1 rounded">
                          {tag}
                        </span>
                      ))}
                    </div>
                    <h2 class="font-bold text-navy-900 leading-snug group-hover:text-orange-500 transition-colors">
                      {post.data.title}
                    </h2>
                    <p class="mt-2 text-sm text-muted leading-relaxed flex-1">
                      {post.data.description}
                    </p>
                    <div class="mt-4 flex items-center justify-between text-xs text-muted pt-4 border-t border-slate-100">
                      <time datetime={post.data.publishDate.toISOString()}>
                        {dateFormatter.format(post.data.publishDate)}
                      </time>
                      <span class="font-semibold text-orange-500 flex items-center gap-1">
                        Ler mais
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M5 12h14m0 0l-6-6m6 6l-6 6" />
                        </svg>
                      </span>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          )
        }
      </div>
    </section>
  </main>
  <Footer />
</Layout>
