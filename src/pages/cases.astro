---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import FinalCta from "../components/FinalCta.astro";

const projectTypes = [
  {
    title: "Revestimento de rolos industriais",
    segment: "Industrial",
    text: "Aplicação de revestimento antiaderente em rolos submetidos a atrito constante, reduzindo paradas para limpeza e aumentando a vida útil do equipamento.",
  },
  {
    title: "Revestimento para linha alimentícia",
    segment: "Alimentícia",
    text: "Formas e componentes com revestimento que atende normas de contato com alimentos, mantendo segurança e performance na produção.",
  },
  {
    title: "Texturização de componentes automotivos",
    segment: "Automobilística",
    text: "Texturização personalizada em peças de linhas de montagem, melhorando aderência controlada e resistência ao uso intenso.",
  },
  {
    title: "Texturização de cilindros têxteis",
    segment: "Têxtil",
    text: "Padrão de texturização aplicado a cilindros de máquinas têxteis para melhorar o deslizamento do material processado.",
  },
  {
    title: "Revestimento de moldes plásticos",
    segment: "Plástica",
    text: "Acabamento antiaderente em moldes de injeção e extrusão, facilitando a desmoldagem e reduzindo o tempo de ciclo.",
  },
  {
    title: "Revestimento de peças para borracha",
    segment: "Borracha",
    text: "Componentes revestidos para processos de vulcanização, com resistência a altas temperaturas constantes.",
  },
];
---

<Layout
  title="Tipos de Projetos Atendidos | TexFlow"
  description="Conheça os tipos de projetos de revestimento antiaderente e texturização industrial que a TexFlow já atende em diferentes segmentos."
>
  <Header />
  <main>
    <PageHero breadcrumbLabel="Cases" subtitle="Cada segmento exige uma combinação diferente de revestimento e texturização. Veja os tipos de projeto que fazem parte do nosso dia a dia.">
      TIPOS DE PROJETOS QUE <span class="text-orange-500">JÁ ATENDEMOS</span>
    </PageHero>

    <section class="bg-white">
      <div class="max-w-7xl mx-auto px-6 lg:px-10 py-16 lg:py-20">
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {
            projectTypes.map((p) => (
              <div class="bg-slate-50 rounded-xl border border-slate-100 p-6">
                <span class="text-[10px] font-bold uppercase tracking-wide text-orange-600 bg-orange-100 px-2 py-1 rounded">
                  {p.segment}
                </span>
                <h3 class="mt-3 font-bold text-navy-900 leading-snug">{p.title}</h3>
                <p class="mt-2 text-sm text-muted leading-relaxed">{p.text}</p>
              </div>
            ))
          }
        </div>

        <p class="mt-12 text-center text-muted max-w-xl mx-auto leading-relaxed">
          Não encontrou um projeto parecido com o seu? Fale com a nossa equipe técnica —
          avaliamos cada aplicação individualmente.
        </p>
      </div>
    </section>

    <FinalCta />
  </main>
  <Footer />
</Layout>
