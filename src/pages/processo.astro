---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import FinalCta from "../components/FinalCta.astro";

const steps = [
  {
    title: "Diagnóstico e avaliação técnica",
    text: "Avaliamos a peça, o material e as condições de uso do equipamento para indicar o revestimento ou texturização mais adequado — não um acabamento genérico.",
  },
  {
    title: "Preparação da superfície",
    text: "A superfície é preparada para garantir a ancoragem correta do revestimento, considerando o material da peça e o padrão de texturização definido.",
  },
  {
    title: "Aplicação do revestimento ou texturização",
    text: "Aplicamos a solução definida com equipamentos e materiais de ponta, seguindo os parâmetros técnicos de cada processo.",
  },
  {
    title: "Controle de qualidade",
    text: "Cada peça passa por verificação antes da entrega, garantindo aderência, uniformidade e conformidade com o que foi especificado.",
  },
  {
    title: "Entrega e suporte pós-aplicação",
    text: "Entregamos a peça pronta para uso e acompanhamos o desempenho do revestimento também depois da aplicação.",
  },
];
---

<Layout
  title="Nosso Processo de Trabalho | TexFlow"
  description="Conheça as etapas do processo da TexFlow: diagnóstico técnico, preparação de superfície, aplicação do revestimento, controle de qualidade e suporte pós-entrega."
>
  <Header />
  <main>
    <PageHero breadcrumbLabel="Processo" subtitle="Do diagnóstico à entrega, cada etapa do nosso processo existe para garantir que o revestimento certo chegue até a sua peça.">
      COMO É O <span class="text-orange-500">NOSSO PROCESSO</span>
    </PageHero>

    <section class="bg-white">
      <div class="max-w-5xl mx-auto px-6 lg:px-10 py-16 lg:py-20">
        <div class="flex flex-col gap-8">
          {
            steps.map((s, i) => (
              <div class="flex gap-5 items-start">
                <div class="shrink-0 w-11 h-11 rounded-full bg-orange-500 text-white font-extrabold flex items-center justify-center">
                  {i + 1}
                </div>
                <div class="pt-1.5">
                  <h3 class="font-bold text-navy-900 text-lg leading-snug">{s.title}</h3>
                  <p class="mt-2 text-muted leading-relaxed">{s.text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <FinalCta />
  </main>
  <Footer />
</Layout>
