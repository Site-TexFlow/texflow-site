---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import Features from "../components/Features.astro";
import FinalCta from "../components/FinalCta.astro";
---

<Layout
  title="Diferenciais TexFlow | Por que Escolher Nossos Revestimentos"
  description="Alta performance, tecnologia avançada, qualidade comprovada, atendimento especializado e entrega em todo o Brasil. Conheça os diferenciais da TexFlow."
>
  <Header />
  <main>
    <PageHero breadcrumbLabel="Diferenciais" subtitle="O que nos diferencia não é só a técnica — é como aplicamos ela em cada projeto, do diagnóstico à entrega.">
      POR QUE ESCOLHER A <span class="text-orange-500">TEXFLOW</span>
    </PageHero>

    <Features expanded />
    <FinalCta />
  </main>
  <Footer />
</Layout>
