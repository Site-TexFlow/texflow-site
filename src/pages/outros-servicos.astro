---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import CtaForm from "../components/CtaForm.astro";

import outrosServicosImg from "../assets/solucoes/outros-servicos.png";

const services = [
  {
    title: "Placas de Identificação",
    text: "Placas metálicas gravadas para identificação de equipamentos, patrimônio e ambientes industriais, com alta durabilidade e resistência a intempéries.",
    icon: "M4 5h16v14H4zM7 9h10M7 12h10M7 15h6",
    href: "https://gravametal.com.br/placas-de-identificacao/",
  },
  {
    title: "Gravação a Laser",
    text: "Gravação a laser de alta precisão em metais e outros materiais, para identificação, numeração de série e personalização de peças.",
    icon: "M12 2v8M9 10l3 3 3-3M4 21h16",
    href: "https://gravametal.com.br/gravacao-a-laser/",
  },
  {
    title: "Réguas e Escalas Linimétricas",
    text: "Réguas e escalas linimétricas graduadas com gravação precisa, indicadas para uso técnico e industrial que exige exatidão dimensional.",
    icon: "M3 17L17 3l4 4L7 21H3v-4zM11 9l2 2M8 12l2 2M14 6l2 2",
    href: "https://gravametal.com.br/reguas-e-escalas/",
  },
];
---

<Layout
  title="Outros Serviços | Placas e Gravação Metálica - TexFlow"
  description="Conheça os serviços do grupo Gravametal: placas de identificação, gravação a laser e réguas e escalas linimétricas."
>
  <Header />
  <main>
    <PageHero breadcrumbLabel="Outros Serviços" subtitle="Placas de identificação, gravação a laser e réguas e escalas linimétricas — feitas pelo mesmo grupo empresarial da TexFlow.">
      OUTROS <span class="text-orange-500">SERVIÇOS</span>
    </PageHero>

    <section class="bg-white">
      <div class="max-w-7xl mx-auto px-6 lg:px-10 py-16 lg:py-20 grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-muted leading-relaxed text-lg">
            A TexFlow faz parte do mesmo grupo empresarial da Gravametal, uma
            empresa especializada em gravação e placas metálicas com décadas
            de atuação no mercado.
          </p>
          <p class="mt-4 text-muted leading-relaxed text-lg">
            Além dos revestimentos antiaderentes e texturizações industriais
            da TexFlow, o grupo oferece soluções completas em identificação,
            sinalização e gravação de precisão para empresas de todos os
            portes.
          </p>
        </div>
        <div class="relative aspect-[4/3] rounded-2xl overflow-hidden shadow-xl">
          <Image
            src={outrosServicosImg}
            alt="Gravação a laser de precisão em placa metálica"
            widths={[480, 768, 1024]}
            sizes="(min-width: 1024px) 50vw, 100vw"
            quality={78}
            format="webp"
            loading="eager"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </section>

    <section class="bg-slate-50">
      <div class="max-w-7xl mx-auto px-6 lg:px-10 py-16 lg:py-20">
        <h2 class="text-center text-2xl sm:text-3xl font-extrabold text-navy-900">
          PRINCIPAIS <span class="text-orange-500">SERVIÇOS</span>
        </h2>
        <p class="mt-3 text-center text-muted max-w-xl mx-auto leading-relaxed">
          Conheça as soluções oferecidas pelo grupo Gravametal.
        </p>
        <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {
            services.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group bg-white rounded-xl border border-slate-100 shadow-sm p-6 hover:shadow-lg hover:-translate-y-1 transition-all duration-300"
              >
                <div class="flex items-start justify-between gap-3">
                  <div class="w-11 h-11 rounded-full bg-orange-500 flex items-center justify-center">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d={s.icon} />
                    </svg>
                  </div>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-1 text-muted group-hover:text-orange-500 transition-colors">
                    <path d="M7 17L17 7M8 7h9v9" />
                  </svg>
                </div>
                <h3 class="mt-4 font-bold text-navy-900 leading-snug group-hover:text-orange-500 transition-colors">{s.title}</h3>
                <p class="mt-2 text-sm text-muted leading-relaxed">{s.text}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <CtaForm />
  </main>
  <Footer />
</Layout>
