---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import Solutions from "../components/Solutions.astro";
import FinalCta from "../components/FinalCta.astro";
---

<Layout
  title="Soluções em Revestimento Antiaderente e Texturização Industrial | TexFlow"
  description="Conheça as soluções da TexFlow: revestimento antiaderente industrial, alimentício, texturização industrial e mais. Aumente a vida útil dos seus equipamentos."
>
  <Header />
  <main>
    <PageHero breadcrumbLabel="Soluções" subtitle="Soluções que aumentam a vida útil dos seus equipamentos, reduzem custos de manutenção e melhoram a performance dos seus processos.">
      SOLUÇÕES QUE <span class="text-orange-500">PROTEGEM E PERFORMAM</span>
    </PageHero>

    <Solutions expanded />

    <section class="bg-white">
      <div class="max-w-7xl mx-auto px-6 lg:px-10 py-16 lg:py-20">
        <h2 class="text-center text-2xl sm:text-3xl font-extrabold text-navy-900">
          LEIA <span class="text-orange-500">MAIS NO BLOG</span>
        </h2>
        <div class="mt-10 grid sm:grid-cols-2 gap-6 max-w-3xl mx-auto">
          <a
            href="/blog/revestimento-antiaderente-vida-util-equipamentos"
            class="group bg-slate-50 rounded-xl border border-slate-100 p-6 hover:shadow-md transition-shadow"
          >
            <h3 class="font-bold text-navy-900 leading-snug group-hover:text-orange-500 transition-colors">
              Como revestimentos antiaderentes aumentam a vida útil de equipamentos industriais
            </h3>
            <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-orange-500">
              Ler artigo
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14m0 0l-6-6m6 6l-6 6" />
              </svg>
            </span>
          </a>
          <a
            href="/blog/texturizacao-industrial-quando-aplicar"
            class="group bg-slate-50 rounded-xl border border-slate-100 p-6 hover:shadow-md transition-shadow"
          >
            <h3 class="font-bold text-navy-900 leading-snug group-hover:text-orange-500 transition-colors">
              Texturização industrial: quando aplicar em cada tipo de peça
            </h3>
            <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-orange-500">
              Ler artigo
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14m0 0l-6-6m6 6l-6 6" />
              </svg>
            </span>
          </a>
        </div>
      </div>
    </section>

    <FinalCta />
  </main>
  <Footer />
</Layout>
