---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import SolutionGallery from "../components/SolutionGallery.astro";
import FinalCta from "../components/FinalCta.astro";

import antiaderenteAlimenticio from "../assets/solucoes/antiaderente-alimenticio.png";

const benefits = [
  {
    title: "Antiaderência superior",
    text: "Superfície de baixíssimo atrito que evita a aderência de alimentos, facilitando a desmoldagem e reduzindo perdas de produto.",
    icon: "M12 2c-4 5.5-7 9.5-7 13a7 7 0 0014 0c0-3.5-3-7.5-7-13z",
  },
  {
    title: "Resistência térmica",
    text: "Mantém suas propriedades mesmo sob temperaturas elevadas, comuns em processos de cocção e assamento.",
    icon: "M12 2l7 3.5v6c0 5-3 8.5-7 10.5-4-2-7-5.5-7-10.5v-6L12 2z",
  },
  {
    title: "Durabilidade",
    text: "Camada resistente que preserva o desempenho antiaderente ao longo de milhares de ciclos de produção.",
    icon: "M12 2l2.4 4.9 5.4.8-3.9 3.8.9 5.4L12 14.4 7.2 16.9l.9-5.4-3.9-3.8 5.4-.8L12 2z",
  },
  {
    title: "Segurança alimentar",
    text: "Acabamento adequado para contato direto com alimentos, sem comprometer a segurança do processo produtivo.",
    icon: "M9 12l2 2 4-4m5 2a9 9 0 11-18 0 9 9 0 0118 0z",
  },
  {
    title: "Redução de desperdício",
    text: "Menos resíduo de produto aderido à superfície significa menos perda de matéria-prima a cada ciclo.",
    icon: "M22 17l-8.5-8.5-5 5L2 7",
  },
  {
    title: "Facilidade de manutenção",
    text: "Limpeza mais rápida e menos abrasiva, reduzindo o tempo de parada entre produções.",
    icon: "M12 8a4 4 0 100 8 4 4 0 000-8zm8.4 4a8.4 8.4 0 01-.15 1.55l1.65 1.3-1.5 2.6-1.95-.65a8.5 8.5 0 01-2.7 1.55l-.3 2.05h-3l-.3-2.05a8.5 8.5 0 01-2.7-1.55l-1.95.65-1.5-2.6 1.65-1.3A8.4 8.4 0 013.6 12c0-.53.05-1.05.15-1.55L2.1 9.15l1.5-2.6 1.95.65a8.5 8.5 0 012.7-1.55L8.55 3.6h3l.3 2.05a8.5 8.5 0 012.7 1.55l1.95-.65 1.5 2.6-1.65 1.3c.1.5.15 1.02.15 1.55z",
  },
];
---

<Layout
  title="Revestimento Antiaderente Alimentício | TexFlow"
  description="Revestimento antiaderente alimentício da TexFlow, com acabamentos que atendem às normas de contato com alimentos, garantindo segurança e performance na produção."
>
  <Header />
  <main>
    <PageHero breadcrumbLabel="Revestimento Antiaderente Alimentício" subtitle="Acabamentos que atendem às normas para contato com alimentos, com segurança e performance.">
      REVESTIMENTO ANTIADERENTE <span class="text-orange-500">ALIMENTÍCIO</span>
    </PageHero>

    <section class="bg-white">
      <div class="max-w-7xl mx-auto px-6 lg:px-10 py-16 lg:py-20 grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-muted leading-relaxed text-lg">
            O revestimento antiaderente alimentício da TexFlow é essencial
            para indústrias que exigem alta performance, segurança e
            conformidade com normas sanitárias no contato com alimentos.
            Desenvolvido para formas, esteiras e componentes de linhas de
            produção, o revestimento oferece antiaderência superior e
            resistência térmica, mesmo em processos com temperaturas
            elevadas.
          </p>
          <p class="mt-4 text-muted leading-relaxed text-lg">
            Somos especialistas na aplicação de PTFE (Teflon®) em
            superfícies metálicas, com acabamento duradouro que reduz o
            desperdício de produto, facilita a limpeza e mantém a
            produtividade da linha ao longo de milhares de ciclos.
          </p>
        </div>
        <div class="relative aspect-[4/3] rounded-2xl overflow-hidden shadow-xl">
          <Image
            src={antiaderenteAlimenticio}
            alt="Peças com revestimento antiaderente para a indústria alimentícia"
            widths={[480, 768, 1024]}
            sizes="(min-width: 1024px) 50vw, 100vw"
            quality={78}
            format="webp"
            loading="eager"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </section>

    <section class="bg-slate-50">
      <div class="max-w-7xl mx-auto px-6 lg:px-10 py-16 lg:py-20">
        <h2 class="text-center text-2xl sm:text-3xl font-extrabold text-navy-900">
          BENEFÍCIOS DO <span class="text-orange-500">REVESTIMENTO ALIMENTÍCIO</span>
        </h2>
        <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {
            benefits.map((b) => (
              <div class="bg-white rounded-xl border border-slate-100 shadow-sm p-6">
                <div class="w-11 h-11 rounded-full bg-orange-500 flex items-center justify-center">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d={b.icon} />
                  </svg>
                </div>
                <h3 class="mt-4 font-bold text-navy-900 leading-snug">{b.title}</h3>
                <p class="mt-2 text-sm text-muted leading-relaxed">{b.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <SolutionGallery category="Revestimento Antiaderente Alimentício" lightboxGroup="lightbox-alimenticio" />

    <FinalCta />
  </main>
  <Footer />
</Layout>
